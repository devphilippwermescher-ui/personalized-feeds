{
  "manifest_version": 3,
  "name": "myFeedPilot",
  "version": "0.1.5",
  "description": "Manage personalized LinkedIn feeds, profile lists, and sharing",
  "permissions": ["storage", "tabs", "scripting", "offscreen", "alarms", "cookies", "webRequest", "webNavigation"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://us-central1-myfeedpilot-dev.cloudfunctions.net/*",
    "https://us-central1-myfeedpilot-staging.cloudfunctions.net/*",
    "https://us-central1-myfeedpilot-production.cloudfunctions.net/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://myfeedpilot-dev.web.app/*",
      "https://myfeedpilot-staging.web.app/*",
      "https://myfeedpilot-app.web.app/*",
      "http://localhost:5173/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["linkedin-invite-network-hook.js", "linkedin-analytics-network-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.linkedin.com/feed*", "https://www.linkedin.com/feed/*"],
      "js": ["sharefeed-capture.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://myfeedpilot-dev.web.app/*",
        "https://myfeedpilot-staging.web.app/*",
        "https://myfeedpilot-app.web.app/*",
        "http://localhost:5173/*"
      ],
      "js": ["dashboard-extension-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/preload/*"],
      "js": ["messaging-content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["profile-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["feeds-sidebar.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "linkedin-invite-network-hook.js", "linkedin-analytics-network-hook.js"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "myFeedPilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
