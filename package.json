{
  "name": "personalized-feeds",
  "version": "0.1.5",
  "private": true,
  "description": "Personalized Feeds - Chrome extension + Dashboard",
  "scripts": {
    "dev:extension": "cd extension && npm run dev",
    "dev:billing-local": "cd extension && npm run dev:billing-local",
    "dev:dashboard": "cd dashboard && npm run dev",
    "build:billing-local": "cd extension && npm run build:billing-local",
    "emulators:billing": "node scripts/run-billing-emulators.mjs",
    "simulate:billing-webhook": "npm --prefix functions run simulate:webhook --",
    "build:functions": "cd functions && npm run build",
    "build:extension": "cd extension && npm run build",
    "build:dashboard": "cd dashboard && npm run build",
    "build": "npm run build:extension && npm run build:dashboard && npm run build:functions",
    "deploy:dashboard": "npm run build:dashboard && firebase deploy --only hosting:dashboard --project production",
    "install:all": "cd extension && npm install && cd ../dashboard && npm install && cd ../functions && npm install",
    "type-check": "cd extension && npm run type-check && cd ../dashboard && npm run type-check && cd ../functions && npm run type-check",
    "test:functions": "cd functions && npm test",
    "lint": "cd extension && npm run lint",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,js}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,js}\" --ignore-path .prettierignore",
    "package": "cd extension && npm run package",
    "version:set": "node scripts/set-version.mjs"
  },
  "keywords": [
    "linkedin",
    "chrome-extension",
    "analytics",
    "feeds"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "firebase": "^11.10.0"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
