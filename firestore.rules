rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function shareDoc(userId, feedId) {
      return get(/databases/$(database)/documents/users/$(userId)/feeds/$(feedId)/shares/$(request.auth.uid));
    }

    function hasFeedReadAccess(userId, feedId) {
      return isOwner(userId) || (signedIn() && exists(/databases/$(database)/documents/users/$(userId)/feeds/$(feedId)/shares/$(request.auth.uid)));
    }

    function hasFeedWriteAccess(userId, feedId) {
      return isOwner(userId) || (
        signedIn() &&
        exists(/databases/$(database)/documents/users/$(userId)/feeds/$(feedId)/shares/$(request.auth.uid)) &&
        shareDoc(userId, feedId).data.role == 'editor'
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if isOwner(userId);

      match /feeds/{feedId} {
        allow read: if hasFeedReadAccess(userId, feedId);
        allow create, delete: if isOwner(userId);
        allow update: if isOwner(userId) || (
          hasFeedWriteAccess(userId, feedId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt']) &&
          request.resource.data.memberCount is int &&
          request.resource.data.memberCount >= 0
        );

        match /members/{memberId} {
          allow read: if hasFeedReadAccess(userId, feedId);
          allow write: if hasFeedWriteAccess(userId, feedId);
        }

        match /shares/{targetUid} {
          allow read: if isOwner(userId) || (signedIn() && request.auth.uid == targetUid);
          // Creation and removal run through callable Functions so both users'
          // limits and usage counters change atomically.
          allow create, delete: if false;
          allow update: if isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
            && request.resource.data.role in ['reader', 'editor'];
        }
      }

      match /followedFeeds/{followedFeedId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'sortOrder'])
          && request.resource.data.role in ['reader', 'editor'];
        allow create, delete: if false;
      }

      match /shareNotifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'dismissed';
        allow create, delete: if false;
      }

      match /profileViewers/{viewerId} {
        allow read, write: if isOwner(userId);
      }

      match /profileViewerSearches/{searchId} {
        allow read, write: if isOwner(userId);
      }

      match /profileViewerMetadata/{metadataId} {
        allow read, write: if isOwner(userId);
      }

      match /profileAnalytics/{documentId} {
        allow read, write: if isOwner(userId);
      }

      match /profileAnalyticsDaily/{snapshotId} {
        allow read, write: if isOwner(userId);
      }

      match /profileAnalyticsSamples/{sampleId} {
        allow read, write: if isOwner(userId);
      }

      match /contentAnalytics/{documentId} {
        allow read, write: if isOwner(userId);
      }

      match /contentAnalyticsRanges/{rangeId} {
        allow read, write: if isOwner(userId);
      }

      match /contentAnalyticsDaily/{snapshotId} {
        allow read, write: if isOwner(userId);
      }

      match /contentAnalyticsPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      match /dashboardAnalyticsSync/{documentId} {
        allow read, write: if isOwner(userId);
      }

      match /profileAnalyticsJobs/{jobId} {
        allow read, write: if isOwner(userId);
      }

      match /profileAnalyticsHistoryChunks/{chunkId} {
        allow read, write: if isOwner(userId);
      }

      match /connectionInvites/{inviteId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

    }

    match /emailIndex/{email} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /feedShareLinks/{token} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /sharingUsage/{userId} {
      allow read, write: if false;
    }

    match /sharingPairs/{pairId} {
      allow read, write: if false;
    }

    match /sharingFeedUsage/{feedId} {
      allow read, write: if false;
    }
  }
}
