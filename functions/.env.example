# Non-secret Lemon Squeezy identifiers. Copy these values into the Firebase
# project's environment configuration; do not put API keys in this file.
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_MONTHLY_VARIANT_ID=2069629
LEMON_SQUEEZY_ANNUAL_VARIANT_ID=2069645
LEMON_SQUEEZY_TEST_MODE=true

