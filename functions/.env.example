# Non-secret Lemon Squeezy identifiers. USD is required; EUR becomes available
# automatically after all three EUR identifiers are configured.
LEMON_SQUEEZY_USD_STORE_ID=
LEMON_SQUEEZY_USD_MONTHLY_VARIANT_ID=
LEMON_SQUEEZY_USD_ANNUAL_VARIANT_ID=

# Optional until the EUR store is ready.
LEMON_SQUEEZY_EUR_STORE_ID=
LEMON_SQUEEZY_EUR_MONTHLY_VARIANT_ID=
LEMON_SQUEEZY_EUR_ANNUAL_VARIANT_ID=

LEMON_SQUEEZY_TEST_MODE=true

# Configure these with `firebase functions:secrets:set`, never in an env file:
# LEMON_SQUEEZY_API_KEY
# LEMON_SQUEEZY_WEBHOOK_SECRET
