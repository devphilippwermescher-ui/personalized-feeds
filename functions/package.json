{
  "name": "myfeedpilot-functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run src",
    "simulate:webhook": "node scripts/simulate-local-webhook.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "qs": "6.16.0"
  }
}
